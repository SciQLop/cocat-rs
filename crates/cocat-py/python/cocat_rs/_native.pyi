from typing import Any

class Catalogue:
    uuid: str
    name: str
    author: str
    tags: set[str]
    attributes: dict[str, Any]
    events: set[Event]
    def set_attributes(self, **attributes: Any) -> None: ...
    def remove_attributes(self, keys: str | list[str]) -> None: ...
    def add_events(self, events: list[Event | str]) -> None: ...
    def remove_events(self, events: list[Event | str]) -> None: ...
    def delete(self) -> None: ...
    def event_arrays(self, attributes: bool = False) -> dict[str, Any]: ...
    def event_attributes(
        self, keys: list[str] | None = None
    ) -> list[dict[str, Any]]: ...

class Event:
    uuid: str
    start: Any
    stop: Any
    range: tuple[Any, Any]
    author: str
    rating: int | None
    tags: set[str]
    products: set[str]
    attributes: dict[str, Any]
    def set_attributes(self, **attributes: Any) -> None: ...
    def remove_attributes(self, keys: str | list[str]) -> None: ...
    def delete(self) -> None: ...

class RoomInfo:
    def __init__(self, id: str, name: str, role: str) -> None: ...
    id: str
    name: str
    role: str

class Room:
    @staticmethod
    def open(cache_dir: str, room_id: str) -> Room: ...
    status: str
    def connect(self, url: str, cookie: str) -> None: ...
    def set_cookie(self, cookie: str) -> None: ...
    def close(self) -> None: ...
    def wait_synced(self, timeout: float | None = None) -> None: ...
    def next_batch(
        self, timeout: float | None = None
    ) -> list[dict[str, Any]] | None: ...
    def begin_batch(self) -> None: ...
    def end_batch(self) -> None: ...
    def catalogues(self) -> list[Catalogue]: ...
    def catalogue(self, uuid_or_name: str) -> Catalogue: ...
    def event(self, uuid: str) -> Event: ...
    def create_catalogue(
        self,
        name: str,
        author: str,
        uuid: str | None = None,
        tags: list[str] | None = None,
        attributes: dict[str, Any] | None = None,
        events: list[Event | str] | None = None,
    ) -> Catalogue: ...
    def create_event(
        self,
        start: Any,
        stop: Any,
        author: str,
        uuid: str | None = None,
        tags: list[str] | None = None,
        products: list[str] | None = None,
        rating: int | None = None,
        attributes: dict[str, Any] | None = None,
    ) -> Event: ...
    def save(self, timeout: float | None = None) -> None: ...
    def import_votable(self, path: str, table_name: str | None = None) -> int: ...

def login(url: str, username: str, password: str) -> str: ...
def rooms(url: str, cookie: str) -> list[RoomInfo]: ...
def export_votable(catalogues: Catalogue | list[Catalogue]) -> str: ...
