from datetime import datetime
from typing import Any, Literal

Status = Literal["preliminary", "confirmed", "reviewed", "final", "rejected", "deleted"]
# unauthorized: sign in again. no_access: this account is no longer in the project.
Connection = Literal["offline", "connecting", "synced", "unauthorized", "no_access"]
Vertex = tuple[datetime, float]
# (quantity, unit), e.g. ("frequency", "kHz") or ("energy", "eV").
ShapeAxis = tuple[str, str]

class NotFound(LookupError, RuntimeError): ...

class ServerError(ValueError):
    status: int
    detail: str

class Unauthorized(ServerError): ...
class Forbidden(ServerError): ...
class ServerNotFound(ServerError, NotFound): ...
class Conflict(ServerError): ...

class Catalogue:
    uuid: str
    name: str
    author: str | None
    created: datetime | None
    deleted: bool
    project: str
    tags: set[str]
    columns: list[str]
    attributes: dict[str, Any]
    rule: dict[str, Any] | None
    query: str | None
    shape_axis: ShapeAxis | None
    events: set[Event]
    @property
    def copied_from(self) -> list[dict[str, Any]]: ...
    def materialize(self, name: str) -> Catalogue: ...
    def to_pandas(self) -> Any: ...
    def to_polars(self) -> Any: ...
    def set_attributes(self, **attributes: Any) -> None: ...
    def remove_attributes(self, keys: str | list[str]) -> None: ...
    def add_events(self, events: list[Event | str]) -> None: ...
    def remove_events(self, events: list[Event | str]) -> None: ...
    def delete(self) -> None: ...
    def restore(self) -> None: ...
    def purge(self) -> None: ...
    def event_arrays(self, attributes: bool = False) -> dict[str, Any]: ...
    def event_attributes(
        self, keys: list[str] | None = None
    ) -> list[dict[str, Any]]: ...

class Event:
    uuid: str
    start: datetime
    stop: datetime
    range: tuple[datetime, datetime]
    author: str | None
    created: datetime | None
    origin: str | None
    status: Status
    confidence: float | None
    start_err: float | None
    stop_err: float | None
    shape: list[Vertex] | None
    source_id: str | None
    comment: str | None
    tags: set[str]
    products: set[str]
    attributes: dict[str, Any]
    catalogues: list[str]
    def set_attributes(self, **attributes: Any) -> None: ...
    def remove_attributes(self, keys: str | list[str]) -> None: ...
    def delete(self) -> None: ...
    def restore(self) -> None: ...
    def purge(self) -> None: ...

class ProjectInfo:
    def __init__(
        self,
        id: str,
        name: str,
        role: str,
        personal: bool = False,
        editors_can_share: bool = True,
    ) -> None: ...
    id: str
    name: str
    role: str
    personal: bool
    editors_can_share: bool

class Project:
    @staticmethod
    def open(cache_dir: str, project_id: str) -> Project: ...
    @staticmethod
    def at(url: str, cookie: str, project_id: str, version: int) -> Project: ...
    status: Connection
    def set_identity(self, project_name: str, email: str, personal: bool = False) -> None: ...
    def links(self) -> list[dict[str, Any]]: ...
    def link(self, catalogue: Catalogue) -> str: ...
    def unlink(self, id: str) -> bool: ...
    role: str | None
    read_only: bool
    def connect(
        self,
        url: str,
        cookie: str | None = None,
        credentials: tuple[str, str] | None = None,
    ) -> None: ...
    def set_cookie(self, cookie: str) -> None: ...
    def close(self) -> None: ...
    def wait_synced(self, timeout: float | None = None) -> None: ...
    def next_batch(
        self, timeout: float | None = None
    ) -> list[dict[str, Any]] | None: ...
    def begin_batch(self) -> None: ...
    def end_batch(self) -> None: ...
    def catalogues(self) -> list[Catalogue]: ...
    def catalogue(self, uuid_or_name: str) -> Catalogue: ...
    def event(self, uuid: str) -> Event: ...
    def search(self, query: str) -> list[Event]: ...
    def search_public(self, query: str) -> dict[str, Any]: ...
    def create_smart_catalogue(
        self,
        name: str,
        query: str,
        source: Catalogue | str | None = None,
        public: bool = False,
    ) -> Catalogue: ...
    def trash(self) -> list[Event]: ...
    def existing_tags(self) -> list[str]: ...
    def attribute_types(self) -> dict[str, dict[str, str | None]]: ...
    def set_attribute_info(
        self,
        key: str,
        unit: str | None = None,
        description: str | None = None,
        type: Literal["number", "text", "bool", "date"] | None = None,
    ) -> None: ...
    def create_origin(
        self,
        kind: Literal["rule", "detector", "model", "import"],
        name: str,
        version: str | None = None,
        author: str | None = None,
        created: datetime | str | None = None,
        used: list[dict[str, str]] | None = None,
        parameters: Any = None,
        derived_from: str | None = None,
        id: str | None = None,
    ) -> str: ...
    def origin(self, id: str) -> dict[str, Any]: ...
    def event_arrays(
        self, events: list[Event | str], attributes: bool = False
    ) -> dict[str, Any]: ...
    def create_catalogue(
        self,
        name: str,
        author: str | None = None,
        uuid: str | None = None,
        tags: list[str] | None = None,
        attributes: dict[str, Any] | None = None,
        events: list[Event | str] | None = None,
        columns: list[str] | None = None,
    ) -> Catalogue: ...
    def create_event(
        self,
        start: datetime | str,
        stop: datetime | str,
        author: str | None = None,
        uuid: str | None = None,
        tags: list[str] | None = None,
        products: list[str] | None = None,
        attributes: dict[str, Any] | None = None,
        status: Status | None = None,
        confidence: float | None = None,
        start_err: float | None = None,
        stop_err: float | None = None,
        origin: str | None = None,
        source_id: str | None = None,
        created: datetime | str | None = None,
        comment: str | None = None,
        shape: list[Vertex] | None = None,
    ) -> Event: ...
    def merge(self, source: Project) -> dict[str, int]: ...
    def save(self, timeout: float | None = None) -> None: ...
    def import_votable(self, path: str, table_name: str | None = None) -> int: ...
    def import_tscat_json(self, text: str) -> list[str]: ...
    def import_tfcat(self, path: str, name: str | None = None) -> Catalogue: ...
    def import_csv(self, path: str, name: str | None = None) -> Catalogue: ...
    def import_hpevent(self, path: str, name: str | None = None) -> Catalogue: ...

