# Mail settings for cocat-server, passed to the container with --env-file.
# Copy this file, fill it in and keep the copy private (chmod 600): it holds the relay password.
# COCAT_PUBLIC_URL must be set as well: every mailed link is built from it.
COCAT_SMTP_HOST=smtp.example.org
COCAT_SMTP_PORT=587
COCAT_SMTP_STARTTLS=true
# Both or neither: leave them empty for a relay that needs no login.
COCAT_SMTP_USERNAME=
COCAT_SMTP_PASSWORD=
COCAT_MAIL_FROM=cocat@example.org
