# Mail settings for the cocat server, passed to the container with --env-file.
# Copy to ~/.config/cocat-rs-dev/mail.env (chmod 600) and fill in the account.
# hermes offers STARTTLS on port 25 (cocat's default when COCAT_SMTP_STARTTLS is unset).
COCAT_SMTP_HOST=hermes.lpp.polytechnique.fr
COCAT_SMTP_PORT=25
COCAT_SMTP_USERNAME=
COCAT_SMTP_PASSWORD=
COCAT_MAIL_FROM=
